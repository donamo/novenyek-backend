DATABASE_URL=postgresql://postgres:postgres@192.168.1.2:5432/novenyek
PORT=3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug
NOT_FOUND_DELAY_MS=0
UPLOAD_DIR=./uploads
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_STORE=postgres
SESSION_TTL_SECONDS=1209600
TRUST_PROXY=0
ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback/google
AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_MONTHLY_IMAGE_LIMIT=30
AI_MAX_PHOTOS_PER_ANALYSIS=3
AI_MAX_OUTPUT_TOKENS=500
AI_IMAGE_MAX_SIZE=1280
NODE_ENV=development
